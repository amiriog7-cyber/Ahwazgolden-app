<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- نوار بالایی با دکمه‌های ناوبری -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#16213e"
        android:padding="8dp"
        android:weightSum="5">

        <Button
            android:id="@+id/btnCalculator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ماشین حساب"
            android:textSize="11sp"
            android:background="@drawable/nav_button"
            android:textColor="#d4af37"
            android:onClick="openCalculator"
            android:padding="8dp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btnNews"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="اخبار"
            android:textSize="11sp"
            android:background="@drawable/nav_button"
            android:textColor="#d4af37"
            android:onClick="openNews"
            android:padding="8dp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btnPrices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="قیمت‌ها"
            android:textSize="11sp"
            android:background="@drawable/nav_button"
            android:textColor="#d4af37"
            android:onClick="openPrices"
            android:padding="8dp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btnGold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="قیمت طلا"
            android:textSize="11sp"
            android:background="@drawable/nav_button"
            android:textColor="#d4af37"
            android:onClick="openGold"
            android:padding="8dp"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btnCrypto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ارز دیجیتال"
            android:textSize="11sp"
            android:background="@drawable/nav_button"
            android:textColor="#d4af37"
            android:onClick="openCrypto"
            android:padding="8dp"
            android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressTint="#d4af37"
        android:max="100"
        android:visibility="gone" />

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
